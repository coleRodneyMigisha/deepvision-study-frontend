{
  "name": "studyroom-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.ts",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "content:merge": "node scripts/merge-draft.ts",
    "verify:exercises": "uv run -q --with pandas --with numpy --with scikit-learn --with scipy --with duckdb --with pydantic --with pyyaml --with joblib python scripts/verify-exercises.py"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "15.5.28",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  }
}
